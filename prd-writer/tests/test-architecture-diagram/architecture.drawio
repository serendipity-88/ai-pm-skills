<mxGraphModel adaptiveColors="auto">
  <root>
    <mxCell id="0"/>
    <mxCell id="1" parent="0"/>

    <!-- Background -->
    <mxCell id="bg" value="" style="whiteSpace=wrap;html=1;fillColor=#0f172a;strokeColor=none;" vertex="1" parent="1">
      <mxGeometry x="0" y="0" width="1200" height="800" as="geometry"/>
    </mxCell>

    <!-- Kubernetes Cluster Boundary -->
    <mxCell id="k8s" value="Kubernetes Cluster" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#fbbf24;strokeWidth=2;dashed=1;dashPattern=8 4;fontColor=#fbbf24;" vertex="1" parent="1">
      <mxGeometry x="100" y="220" width="1000" height="400" as="geometry"/>
    </mxCell>

    <!-- Frontend Layer -->
    <mxCell id="frontend" value="H5 前端&lt;br>&lt;font color=&quot;#94a3b8&quot; size=&quot;2&quot;&gt;钉钉容器内运行&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=rgba(8, 51, 68, 0.4);strokeColor=#22d3ee;strokeWidth=2;fontColor=#f8fafc;" vertex="1" parent="1">
      <mxGeometry x="450" y="80" width="300" height="70" as="geometry"/>
    </mxCell>

    <!-- External: DingTalk API -->
    <mxCell id="dingtalk" value="钉钉 API&lt;br>&lt;font color=&quot;#94a3b8&quot; size=&quot;2&quot;&gt;免登 / 消息推送&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=rgba(30, 41, 59, 0.5);strokeColor=#94a3b8;strokeWidth=2;dashed=1;fontColor=#f8fafc;" vertex="1" parent="1">
      <mxGeometry x="100" y="80" width="220" height="70" as="geometry"/>
    </mxCell>

    <!-- API Gateway -->
    <mxCell id="gateway" value="API Gateway&lt;br>&lt;font color=&quot;#94a3b8&quot; size=&quot;2&quot;&gt;鉴权 / 限流 / 路由&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=rgba(6, 78, 59, 0.4);strokeColor=#34d399;strokeWidth=2;fontColor=#f8fafc;" vertex="1" parent="1">
      <mxGeometry x="450" y="200" width="300" height="70" as="geometry"/>
    </mxCell>

    <!-- Business Services -->
    <mxCell id="booking-service" value="预订服务&lt;br>&lt;font color=&quot;#94a3b8&quot; size=&quot;2&quot;&gt;核心业务逻辑&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=rgba(6, 78, 59, 0.4);strokeColor=#34d399;strokeWidth=2;fontColor=#f8fafc;" vertex="1" parent="1">
      <mxGeometry x="150" y="330" width="200" height="70" as="geometry"/>
    </mxCell>

    <mxCell id="room-service" value="会议室服务&lt;br>&lt;font color=&quot;#94a3b8&quot; size=&quot;2&quot;&gt;会议室/时段管理&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=rgba(6, 78, 59, 0.4);strokeColor=#34d399;strokeWidth=2;fontColor=#f8fafc;" vertex="1" parent="1">
      <mxGeometry x="400" y="330" width="200" height="70" as="geometry"/>
    </mxCell>

    <mxCell id="approval-service" value="审批服务&lt;br>&lt;font color=&quot;#94a3b8&quot; size=&quot;2&quot;&gt;自动审批规则&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=rgba(6, 78, 59, 0.4);strokeColor=#34d399;strokeWidth=2;fontColor=#f8fafc;" vertex="1" parent="1">
      <mxGeometry x="650" y="330" width="200" height="70" as="geometry"/>
    </mxCell>

    <!-- Message Bus -->
    <mxCell id="mq" value="RocketMQ 消息总线" style="rounded=1;whiteSpace=wrap;html=1;fillColor=rgba(251, 146, 60, 0.3);strokeColor=#fb923c;strokeWidth=2;fontColor=#fb923c;" vertex="1" parent="1">
      <mxGeometry x="400" y="450" width="200" height="40" as="geometry"/>
    </mxCell>

    <!-- Data Layer -->
    <mxCell id="mysql" value="MySQL&lt;br>&lt;font color=&quot;#94a3b8&quot; size=&quot;2&quot;&gt;主数据库&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=rgba(76, 29, 149, 0.4);strokeColor=#a78bfa;strokeWidth=2;fontColor=#f8fafc;" vertex="1" parent="1">
      <mxGeometry x="150" y="540" width="140" height="80" as="geometry"/>
    </mxCell>

    <mxCell id="redis" value="Redis&lt;br>&lt;font color=&quot;#94a3b8&quot; size=&quot;2&quot;&gt;缓存 / 分布式锁&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=rgba(76, 29, 149, 0.4);strokeColor=#a78bfa;strokeWidth=2;fontColor=#f8fafc;" vertex="1" parent="1">
