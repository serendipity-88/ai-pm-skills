      <mxGeometry x="750" y="540" width="160" height="80" as="geometry"/>
    </mxCell>

    <!-- Arrows -->
    <mxCell id="arrow1" value="" style="endArrow=classic;html=1;strokeColor=#64748b;strokeWidth=2;" edge="1" parent="1">
      <mxGeometry width="50" height="50" relative="1" as="geometry">
